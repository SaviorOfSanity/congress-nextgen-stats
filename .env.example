# Congress Civic Analytics Environment Variables (Copy to .env)

# Optional Official Government API Keys (app runs out of the box with Voteview + House FD + DEMO_KEY OpenFEC + Census Geocoder)
CONGRESS_API_KEY=
FEC_API_KEY=
CENSUS_API_KEY=

# Security Settings for Public / Cloudflare Tunnel Deployment
# Set a strong random secret for ADMIN_API_KEY to protect POST /api/admin/sync and POST /api/video/generate
ADMIN_API_KEY=

# Comma-separated list of permitted CORS origins (e.g. https://congress.yourdomain.com,http://localhost:8000)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
